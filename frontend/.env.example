# Frontend environment variables (customer-support-agent).
# Copy to frontend/.env.local and adjust. Vite only exposes vars prefixed
# VITE_ to client code. No secrets belong here (backend holds
# ANTHROPIC_API_KEY — see backend/.env.example).

# Base URL of the FastAPI backend (see backend/.env.example PORT).
VITE_API_BASE_URL=http://localhost:8000
