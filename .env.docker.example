# Template for the LOCAL docker-compose convenience only (see
# docker-compose.yml). This is NOT read by the Railway deploy — Railway
# services get their environment variables from the Railway dashboard
# instead (see project-context/3.deliver/deploy.md's *define-deploy
# entry, 2026-09-02, for the exact per-service variable list).
#
# Usage:
#   cp .env.docker.example .env.docker
#   # edit .env.docker with real values, then:
#   docker compose --env-file .env.docker up --build
#
# `.env.docker` is already covered by this repo's root .gitignore
# (`.env.*` pattern) — it will not be committed. Never put real secret
# values in this .example file itself.

# Required. Passed through to the backend container. Same variable/meaning
# as backend/.env.example's ANTHROPIC_API_KEY (sad.md §4).
ANTHROPIC_API_KEY=

# Optional. Comma-separated browser origins allowed to call the backend
# API (backend/.env.example's CORS_ALLOWED_ORIGINS). The app's built-in
# default (localhost:5173/5174) targets the Vite *dev server*, which does
# not apply once both services run in containers — set this to match
# FRONTEND_HOST_PORT below (default: http://localhost:5173).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional. Base URL the frontend's static build is compiled against.
# Vite inlines VITE_-prefixed vars into the JS bundle at image BUILD time
# (see frontend/Dockerfile) — changing this after the image is built
# requires `docker compose up --build` again, not just a restart. Must
# match wherever the backend is actually reachable from the browser (the
# HOST side of BACKEND_HOST_PORT below).
VITE_API_BASE_URL=http://localhost:8000

# Optional. Host-side port mappings only — container-internal ports stay
# fixed (8000 backend, 80 frontend; see both Dockerfiles). Change these if
# the defaults conflict with something else already running locally; if
# you change BACKEND_HOST_PORT, update VITE_API_BASE_URL above to match
# and rebuild.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
