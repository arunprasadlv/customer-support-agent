# Backend environment variables (customer-support-agent).
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# See project-context/1.define/sad.md §4 (Authentication & Secrets) and
# .claude/rules/adapter-claude-agent-sdk.md is NOT used here — this is the
# crewai adapter (AAMAD_TARGET_RUNTIME=crewai).

# Required. LLM provider is Anthropic (sad.md, stakeholder-confirmed).
# Per-agent model tiers are set in code/config (ADR-004: claude-haiku-4-5,
# claude-sonnet-5) — this key just authenticates all calls.
ANTHROPIC_API_KEY=

# Optional. Local data store path (SQLite/file-based per sad.md §4 Data
# Architecture). Defaults assumed by @backend.eng if unset.
DATABASE_URL=sqlite:///./data/app.db

# Optional. FastAPI/uvicorn bind port (sad.md §5 requires a /health
# endpoint; port itself is not fixed by SAD).
PORT=8000
